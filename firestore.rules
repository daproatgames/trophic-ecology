rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts are addressed by a client-side credential hash. There is no
    // list operation, so account IDs are not enumerable.
    match /accounts/{accountId} {
      allow get: if true;
      allow list: if false;
      allow create: if validAccount(accountId);
      allow update: if validAccount(accountId);
      allow delete: if false;
    }
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if username.matches('^[a-z0-9_.-]{3,24}$')
        && request.resource.data.accountId is string
        && request.resource.data.accountId.matches('^[a-f0-9]{64}$');
      allow update, delete: if false;
    }
    match /saves/{accountId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if validSave(accountId);
      allow delete: if false;
    }
    match /leaderboard_karting/{accountId} { allow read: if true; allow create, update: if validScore(accountId); }
    match /leaderboard_exam/{accountId} { allow read: if true; allow create, update: if validScore(accountId); }
    match /leaderboard_mastery/{accountId} { allow read: if true; allow create, update: if validScore(accountId); }
    match /leaderboard_xp/{accountId} { allow read: if true; allow create, update: if validScore(accountId); }

    function validAccount(accountId) {
      return accountId.matches('^[a-f0-9]{64}$')
        && request.resource.data.accountId == accountId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24;
    }
    function validSave(accountId) {
      return accountId.matches('^[a-f0-9]{64}$')
        && request.resource.data.accountId == accountId
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000;
    }
    function validScore(accountId) {
      return accountId.matches('^[a-f0-9]{64}$')
        && exists(/databases/$(database)/documents/accounts/$(accountId))
        && request.resource.data.accountId == accountId
        && request.resource.data.name == get(/databases/$(database)/documents/accounts/$(accountId)).data.name
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100;
    }
  }
}
